# Normalise text to LF in the repository; Windows-only scripts keep CRLF on checkout.
* text=auto eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets: never touch line endings, never diff as text.
*.png binary
*.jpg binary
*.ttf binary
*.otf binary
*.wav binary
*.flac binary
*.aif binary
*.aiff binary
*.exe binary
*.zip binary
